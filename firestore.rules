rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return signedIn() &&
        request.auth.token.get('email', '') == 'thyagopatriota2020@gmail.com';
    }

    function adminNotDeactivated() {
      return request.auth.token.get('email', '') == '' ||
        !exists(/databases/$(database)/documents/usuarios/$(request.auth.token.email)) ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.token.email))
          .data.get('status', 'ativo') != 'inativo';
    }

    function isAdmin() {
      return signedIn() &&
        (isMasterAdmin() ||
         ((request.auth.token.get('role', '') == 'admin' ||
           request.auth.token.get('admin', false) == true ||
           request.auth.token.get('email', '') in [
             'guladpizza@gmail.com',
             '1986.andersonbernardo@gmail.com'
           ]) && adminNotDeactivated()));
    }

    function isOwner(clienteId) {
      return signedIn() && request.auth.uid == clienteId;
    }

    function validOwnProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'nome',
        'telefone',
        'email',
        'endereco',
        'cidade',
        'estado',
        'cep',
        'whatsapp',
        'atualizadoEm',
        'atualizadoEmMs'
      ]);
    }

    match /clientes/{clienteId} {
      allow read: if isOwner(clienteId) || isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isOwner(clienteId) && validOwnProfileUpdate());
    }

    match /unidades/{unidadeId} {
      allow read: if isOwner(resource.data.clienteId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /faturas/{faturaId} {
      allow read: if isAdmin() ||
        (resource.data.status == 'disponivel' &&
         isOwner(resource.data.clienteId));
      allow create: if isAdmin() &&
        request.resource.data.status != 'disponivel';
      allow update: if isAdmin() &&
        ((resource.data.status != 'disponivel' &&
          request.resource.data.status != 'disponivel') ||
         (resource.data.status == 'disponivel' &&
          request.resource.data.status == 'disponivel' &&
          request.resource.data.clienteId == resource.data.clienteId &&
          request.resource.data.uc == resource.data.uc &&
          request.resource.data.storagePath == resource.data.storagePath &&
          request.resource.data.versao == resource.data.versao &&
          request.resource.data.versaoAtual == resource.data.versaoAtual));
      allow delete: if false;
    }

    match /processamentoFaturas/{processamentoId} {
      allow read, write: if isAdmin();
    }

    match /revisoesFaturas/{revisaoId} {
      allow read, write: if isAdmin();
    }

    match /preCadastros/{preCadastroId} {
      allow read, write: if isAdmin();
    }

    match /atendimento/{chamadoId} {
      allow read: if isOwner(resource.data.clienteId) || isAdmin();
      allow create: if isOwner(request.resource.data.clienteId);
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /pagamentos/{pagamentoId} {
      allow read: if isOwner(resource.data.clienteId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /consumo/{registroId} {
      allow read: if isOwner(resource.data.clienteId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Administrative identities and authorization are provisioned by trusted
    // server code. No client, including an admin, may edit these documents.
    match /usuarios/{usuarioId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Records are written by server-side audit handlers only.
    match /logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditoria/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Server-managed serialization keys prevent concurrent invoice duplicates.
    match /chavesFatura/{chaveId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
