rules_version = '2';

// ==================== REGRAS DE SEGURANÇA — NATURE FORCE ====================
// Princípio: cada cliente só acessa seus próprios dados (cliente A NUNCA vê cliente B).
// O UID do Firebase Authentication é o identificador principal.
// Administradores têm acesso amplo para gestão (autorização por custom claim
// `admin: true` OU e-mail na lista de administradores — ambos suportados).
//
// Modelo em 3 níveis: clientes → unidades (UC) → faturas.
// - A UC é o principal identificador de uma fatura.
// - Um cliente só visualiza UCs/faturas cujo clienteId == seu uid.

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: é um usuário autenticado administrador?
    // Suporta as duas formas de autorização:
    //   1. custom claim `admin: true` (recomendado em produção);
    //   2. e-mail presente na lista de administradores abaixo.
    // A lista deve conter os e-mails usados em /admin/login — caso contrário o
    // administrador fica sem permissão de escrita e as alterações não persistem.
    function isAdmin() {
      return request.auth != null &&
             (request.auth.token.admin == true ||
              request.auth.token.email in ['admin@natureforce.com']);
    }

    // Helper: é o dono (UID == clienteId)?
    function isOwner(clienteId) {
      return request.auth != null && request.auth.uid == clienteId;
    }

    // ==================== CLIENTES ====================
    // O documento é identificado pelo UID do usuário autenticado.
    // O cliente só pode ler/alterar o próprio documento.
    // O ADMINISTRADOR também pode alterar/criar o cadastro do cliente — sem
    // isso, toda alteração feita na Área Administrativa era negada pelo banco
    // e o dado antigo reaparecia após recarregar a página.
    match /clientes/{clienteId} {
      allow read: if isOwner(clienteId) || isAdmin();

      allow create: if (isOwner(clienteId)
                    && request.resource.data.email == request.auth.token.email)
                    || isAdmin();

      allow update: if isOwner(clienteId) || isAdmin();

      allow delete: if false; // Cliente não pode excluir a própria conta
    }

    // ==================== UNIDADES CONSUMIDORAS (UC) ====================
    // O cliente só acessa UCs onde clienteId == seu UID (histórico por UC isolado).
    match /unidades/{unidadeId} {
      allow read: if isOwner(resource.data.clienteId) || isAdmin();

      allow create: if isOwner(request.resource.data.clienteId) || isAdmin();

      allow update: if isOwner(resource.data.clienteId) || isAdmin();

      allow delete: if isAdmin();
    }

    // ==================== FATURAS ====================
    // O cliente só acessa faturas onde clienteId == seu UID.
    // Nunca permitir que Cliente A visualize fatura do Cliente B.
    // Admin pode gerir todas. A criação via admin vincula a fatura ao clienteId correto.
    match /faturas/{faturaId} {
      allow read: if isOwner(resource.data.clienteId) || isAdmin();

      allow create: if isOwner(request.resource.data.clienteId) || isAdmin();

      allow update: if isOwner(resource.data.clienteId) || isAdmin();

      allow delete: if isAdmin();
    }

    // ==================== PROCESSAMENTO DE FATURAS ====================
    // Apenas administradores podem ler/gerenciar processamentos.
    match /processamentoFaturas/{processamentoId} {
      allow read, write: if isAdmin();
    }

    // ==================== REVISÕES DE FATURAS ====================
    // Apenas administradores podem ler/gerenciar revisões (inclusive REVISAO_MANUAL).
    match /revisoesFaturas/{revisaoId} {
      allow read, write: if isAdmin();
    }

    // ==================== PRÉ-CADASTROS (auto-cadastro por fatura) ====================
    // Pré-cadastros criados automaticamente pelo pipeline de importação de PDF.
    // Somente administradores podem ler/gerenciar. Clientes confirmados migram
    // para a coleção 'clientes' e o pré-cadastro é removido.
    match /preCadastros/{preCadastroId} {
      allow read, write: if isAdmin();
    }

    // ==================== ATENDIMENTO ====================
    match /atendimento/{chamadoId} {
      allow read: if isOwner(resource.data.clienteId) || isAdmin();

      allow create: if isOwner(request.resource.data.clienteId);

      allow update: if isOwner(resource.data.clienteId) || isAdmin();

      allow delete: if false;
    }

    // ==================== PAGAMENTOS ====================
    match /pagamentos/{pagamentoId} {
      allow read: if isOwner(resource.data.clienteId) || isAdmin();

      allow create: if isOwner(request.resource.data.clienteId);

      allow update: if isOwner(resource.data.clienteId) || isAdmin();

      allow delete: if false;
    }

    // ==================== CONSUMO ====================
    match /consumo/{registroId} {
      allow read: if isOwner(resource.data.clienteId) || isAdmin();

      allow create: if isOwner(request.resource.data.clienteId);

      allow update: if isOwner(resource.data.clienteId) || isAdmin();

      allow delete: if false;
    }

    // ==================== NEGAÇÃO PADRÃO ====================
    // Qualquer outra coleção/documento é negado por padrão.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}