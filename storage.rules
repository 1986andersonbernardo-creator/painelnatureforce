rules_version = '2';

// ==================== REGRAS DE SEGURANÇA — FIREBASE STORAGE (PDFs de faturas) ====================
// Os arquivos de fatura (PDF original) ficam isolados por cliente/UC.
// Um cliente só lê o próprio PDF; o upload é feito pelo administrador.
// Caminho: faturas/{clienteId}/{unidadeConsumidoraId}/{arquivo}

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null &&
             (request.auth.token.get('admin', false) == true ||
              request.auth.token.get('email', '') in [
                'thyagopatriota2020@gmail.com',
                'guladpizza@gmail.com',
                '1986.andersonbernardo@gmail.com'
              ]);
    }

    // PDFs privados por UID, acessíveis ao cliente dono e à equipe administrativa.
    match /faturas/{clienteId}/{unidadeConsumidoraId}/{arquivo} {
      allow read: if (request.auth != null && request.auth.uid == clienteId) || isAdmin();
      allow create, update: if isAdmin() &&
                            request.resource.size <= 20 * 1024 * 1024 &&
                            request.resource.contentType == 'application/pdf';
      allow delete: if isAdmin();
    }

    // Negação padrão para qualquer outro caminho
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}